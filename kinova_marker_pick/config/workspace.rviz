Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 225; 230; 237
    Fixed Frame: world
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Cell Size: 0.1
      Plane Cell Count: 16
      Value: true
    - Class: moveit_rviz_plugin/MotionPlanning
      Name: MotionPlanning
      Robot Description: robot_description
      Planning Scene Topic: /monitored_planning_scene
      Planning Group: arm
      Value: true
    - Class: rviz_default_plugins/Pose
      Name: Grasp
      Topic:
        Value: /marker_pick/head_grasp_pose
      Value: true
    - Class: rviz_default_plugins/Image
      Name: Overhead camera
      Topic:
        Value: /camera/image
        Reliability Policy: Best Effort
      Value: true
    - Class: rviz_default_plugins/Image
      Name: Eye in hand
      Topic:
        Value: /marker_pick/eih_debug_image
        Reliability Policy: Best Effort
      Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.25
      Focal Point:
        X: 0.25
        Y: 0.0
        Z: 0.22
      Pitch: 0.55
      Yaw: 5.3
Window Geometry:
  Width: 1400
  Height: 900
